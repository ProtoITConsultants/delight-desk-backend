        <mxCell id="title" value="Delight Desk OpenAI Cost Analysis&#xa;Current vs Proposed Model Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;" vertex="1" parent="1">
