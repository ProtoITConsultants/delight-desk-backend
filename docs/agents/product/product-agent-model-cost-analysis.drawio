        <mxCell id="router" value="Model Router&#xa;- Classification / extraction -> gpt-5-nano (or gpt-5.4-nano)&#xa;- Customer-facing generation -> gpt-5.4-mini&#xa;- Embeddings -> text-embedding-3-small (baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
