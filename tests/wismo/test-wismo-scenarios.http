### WISMO Testing - Quick AI Identity Setup
### Use these to quickly switch between test profiles

@baseUrl = http://localhost:3000
@cookie = connect.sid=YOUR_SESSION_COOKIE

### ============================================
### PROFILE 1: Professional (No Emoji)
### ============================================
POST {{baseUrl}}/ai-team-center/identity
Content-Type: application/json
Cookie: {{cookie}}

{
  "aiAgentName": "Sarah",
  "businessType": "E-commerce",
  "aiAgentTitle": "Customer Support Specialist",
  "emailSalutation": "Hi",
  "companyNameForEmailSignature": "Acme Corporation",
  "signatureFooter": "Need help? Visit support.acme.com or call 1-800-ACME",
  "brandVoice": "professional",
  "industrySpecificGuidance": true,
  "thankLoyalCustomers": false,
  "allowEmojiInResponses": false,
  "customInstructions": "Always provide order number and tracking links."
}

### ============================================
### PROFILE 2: Friendly (With Emoji)
### ============================================
POST {{baseUrl}}/ai-team-center/identity
Content-Type: application/json
Cookie: {{cookie}}

{
  "aiAgentName": "Alex",
  "aiAgentTitle": "Support Specialist",
  "emailSalutation": "Hey",
  "companyNameForEmailSignature": "My Store",
  "brandVoice": "friendly",
  "thankLoyalCustomers": true,
  "allowEmojiInResponses": true,
  "customInstructions": "Keep it casual and fun!"
}

### ============================================
### PROFILE 3: Sophisticated (Luxury)
### ============================================
POST {{baseUrl}}/ai-team-center/identity
Content-Type: application/json
Cookie: {{cookie}}

{
  "aiAgentName": "Jordan",
  "businessType": "Luxury Goods",
  "aiAgentTitle": "Client Services Specialist",
  "emailSalutation": "Dear",
  "companyNameForEmailSignature": "Prestige Boutique",
  "signatureFooter": "Exclusive Concierge Service: concierge@prestige.com",
  "brandVoice": "sophisticated",
  "industrySpecificGuidance": true,
  "thankLoyalCustomers": true,
  "allowEmojiInResponses": false
}

### ============================================
### PROFILE 4: Custom Voice with Instructions
### ============================================
POST {{baseUrl}}/ai-team-center/identity
Content-Type: application/json
Cookie: {{cookie}}

{
  "aiAgentName": "Taylor",
  "emailSalutation": "Hello",
  "companyNameForEmailSignature": "TrustCo",
  "brandVoice": "custom",
  "customBrandVoice": "We speak with empathy and authenticity. Our tone is warm yet professional, focusing on building trust and reassuring customers.",
  "thankLoyalCustomers": true,
  "allowEmojiInResponses": false,
  "customInstructions": "Always apologize for any inconvenience. Offer to help with anything else. Never make promises about delivery dates."
}

### ============================================
### PROFILE 5: Friendly + Loyal Customer Focus
### ============================================
POST {{baseUrl}}/ai-team-center/identity
Content-Type: application/json
Cookie: {{cookie}}

{
  "aiAgentName": "Sam",
  "emailSalutation": "Hi",
  "companyNameForEmailSignature": "ValueMart",
  "brandVoice": "friendly",
  "thankLoyalCustomers": true,
  "allowEmojiInResponses": true,
  "customInstructions": "Always thank repeat customers. Offer loyalty discounts when appropriate."
}

### ============================================
### Get Current Identity
### ============================================
GET {{baseUrl}}/ai-team-center/identity
Cookie: {{cookie}}

### ============================================
### Check Recent Escalations
### ============================================
GET {{baseUrl}}/ai-assistant/escalations?page=1&limit=10
Cookie: {{cookie}}

### ============================================
### Check Approval Queue
### ============================================
GET {{baseUrl}}/approval-queue?status=pending
Cookie: {{cookie}}
